# Privy — autenticación (embedded wallets + MetaMask + email/Google)
# Crea una app en https://dashboard.privy.io y copia el App ID aquí.
NEXT_PUBLIC_PRIVY_APP_ID=

# Web Push (VAPID) — genera con: node -e "..." o npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
