# Andes Trust Environment Variables

# Application
NEXT_PUBLIC_APP_NAME="Finca El Progreso"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Privy (auth)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Platform admins: lista de Privy DIDs (did:privy:...) separados por coma.
# Cualquier usuario en esta lista pasa a ser super-admin global tras hacer
# login (ve y edita todas las fincas, gestiona catálogos, etc.).
# Ejemplo: PLATFORM_ADMIN_DIDS=did:privy:cmo7abc...,did:privy:xyz...
PLATFORM_ADMIN_DIDS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret del proyecto (Settings → API → JWT Settings). HS256.
SUPABASE_JWT_SECRET=

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SENTRY=false

# ─── Blockchain (Polygon Amoy testnet) ───────────────────────────────────────
# Clave privada de la wallet relayer (paga el gas en nombre de los usuarios).
# Consigue MATIC de prueba gratis en: https://faucet.polygon.technology
# NUNCA expongas esta clave en el frontend (sin prefijo NEXT_PUBLIC_).
RELAYER_PRIVATE_KEY=

# RPC de Polygon Amoy (puedes usar el público o uno de Alchemy/Infura gratis)
NEXT_PUBLIC_RPC_URL=https://rpc-amoy.polygon.technology

# Dirección del contrato TraceabilityAnchor desplegado (se obtiene al hacer deploy)
NEXT_PUBLIC_ANCHOR_CONTRACT=

# URL del explorador de bloques para links de verificación
NEXT_PUBLIC_EXPLORER_URL=https://amoy.polygonscan.com

# Web Push (VAPID) — genera con: node -e "..." o npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
