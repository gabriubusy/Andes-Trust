# Andes Trust Environment Variables

# Application
NEXT_PUBLIC_APP_NAME="Andes Trust"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Privy (auth)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Platform admins: lista de Privy DIDs (did:privy:...) separados por coma.
# Cualquier usuario en esta lista pasa a ser super-admin global tras hacer
# login (ve y edita todas las fincas, gestiona catálogos, etc.).
# Ejemplo: PLATFORM_ADMIN_DIDS=did:privy:cmo7abc...,did:privy:xyz...
PLATFORM_ADMIN_DIDS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret del proyecto (Settings → API → JWT Settings). HS256.
SUPABASE_JWT_SECRET=

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_SENTRY=false
